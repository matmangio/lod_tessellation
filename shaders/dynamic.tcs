#version 410 core

layout (vertices = 16) out;

in vec3 L_cs[];
in vec3 V_cs[];

out vec3 L_es[];
out vec3 V_es[];

void main() {
	// Send forward values for each control point
	gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
	L_es[gl_InvocationID] = L_cs[gl_InvocationID];
	V_es[gl_InvocationID] = V_cs[gl_InvocationID];

	// Compute the level of detail for each patch
	// TODO
	gl_TessLevelOuter[0] = 15.0;
	gl_TessLevelOuter[1] = 15.0;
	gl_TessLevelOuter[2] = 15.0;
	gl_TessLevelOuter[3] = 15.0;

	gl_TessLevelInner[0] = 10.0;
	gl_TessLevelInner[1] = 10.0;
}
