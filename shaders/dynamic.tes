#version 410 core

layout (triangles, equal_spacing) in;

uniform mat4 projection_matrix;
uniform float dynamic_displacement;

in vec3 L_es[];
in vec3 V_es[];
in vec3 N_es[];

out vec3 L;
out vec3 V;
out vec3 N;

vec3 interpolate(vec3 v0, vec3 v1, vec3 v2) {
    return vec3(gl_TessCoord.x) * v0 + vec3(gl_TessCoord.y) * v1 + vec3(gl_TessCoord.z) * v2;
}

void main() {
	// Interpolate using baricentric coordinates
	L = interpolate(L_es[0], L_es[1], L_es[2]);
	V = interpolate(V_es[0], V_es[1], V_es[2]);
	N = normalize(interpolate(N_es[0], N_es[1], N_es[2]));

	vec3 mv_position = interpolate(gl_in[0].gl_Position.xyz, gl_in[1].gl_Position.xyz, gl_in[2].gl_Position.xyz);
	mv_position += dynamic_displacement * N;

	gl_Position = projection_matrix * vec4(mv_position, 1.0);
}
