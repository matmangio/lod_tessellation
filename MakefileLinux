# source directory
SRCDIR = src

# name of the file
FILENAME = main

CC = gcc
CXX = g++

# Include path
IDIR = ../include

# Libraries path
LDIR = ../libs/linux

# compiler flags:
CXXFLAGS  = -g -O0 -x c++ -Wall -Wno-invalid-offsetof -std=c++11 -I$(IDIR)

# linker flags:
LDFLAGS = -L$(LDIR) -lglfw3 -lassimp -lz -lminizip -lkubazip -lpoly2tri -lpolyclipping -ldraco -lpugixml

SOURCES = $(IDIR)/glad/glad.c $(IDIR)/imgui/imgui_demo.cpp $(IDIR)/imgui/imgui_draw.cpp $(IDIR)/imgui/imgui_impl_glfw.cpp $(IDIR)/imgui/imgui_impl_opengl3.cpp $(IDIR)/imgui/imgui_stdlib.cpp $(IDIR)/imgui/imgui_tables.cpp $(IDIR)/imgui/imgui_widgets.cpp $(IDIR)/imgui/imgui.cpp $(IDIR)/imgui/implot.cpp $(IDIR)/imgui/implot_items.cpp $(FILENAME).cpp

TARGET = ../$(FILENAME).out

.PHONY : all
all:
	cd $(SRCDIR)
	$(CXX) $(CXXFLAGS) $(SOURCES) $(LDFLAGS) -o $(TARGET)
	move ../$(FILENAME).ilk ./$(FILENAME).ilk

.PHONY : clean
clean :
	cd $(SRCDIR)
	-rm $(TARGET)