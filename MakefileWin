# source directory
SRCDIR = src

# name of the file
FILENAME = main

# Visual Studio compiler
CC = cl.exe

# Include path
IDIR = ../include

# Libraries path
LDIR = ../libs/win

# compiler flags:
CCFLAGS  = /Od /Zi /EHsc /MT

# linker flags:
LFLAGS = /OUT:../$(FILENAME).exe /PDB:./$(FILENAME).pdb /LIBPATH:$(LDIR) glfw3.lib assimp-vc143-mt.lib zlib.lib minizip.lib kubazip.lib poly2tri.lib polyclipping.lib draco.lib pugixml.lib gdi32.lib user32.lib Shell32.lib Advapi32.lib

SOURCES = $(IDIR)/glad/glad.c $(FILENAME).cpp

TARGET = $(FILENAME).exe

.PHONY : all
all:
	cd $(SRCDIR)
	$(CC) $(CCFLAGS) /I$(IDIR) $(SOURCES) /Fe:$(TARGET) /link $(LFLAGS)
	move ..\\$(FILENAME).ilk .\\$(FILENAME).ilk

.PHONY : clean
clean :
	cd $(SRCDIR) 
	del $(TARGET)
	del *.obj *.lib *.exp *.ilk *.pdb
